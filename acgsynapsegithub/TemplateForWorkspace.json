				"content": {
					"query": "IF NOT EXISTS (SELECT * FROM sys.external_file_formats WHERE name = 'SynapseParquetFormat') \n\tCREATE EXTERNAL FILE FORMAT [SynapseParquetFormat] \n\tWITH ( FORMAT_TYPE = PARQUET)\nGO\n\nIF NOT EXISTS (SELECT * FROM sys.external_data_sources WHERE name = 'taxidata_teststoragegithub_dfs_core_windows_net') \n\tCREATE EXTERNAL DATA SOURCE [taxidata_teststoragegithub_dfs_core_windows_net] \n\tWITH (\n\t\tLOCATION = 'abfss://taxidata@teststoragegithub.dfs.core.windows.net' \n\t)\nGO\n\n\n\nCREATE EXTERNAL TABLE dbo.Taxi (\n\t[RideId] nvarchar(4000),\n\t[VendorId] nvarchar(4000),\n\t[PickupTime] nvarchar(4000),\n\t[DropTime] nvarchar(4000),\n\t[PickupLocationId] nvarchar(4000),\n\t[DropLocationId] nvarchar(4000),\n\t[CabNumber] nvarchar(4000),\n\t[DriverLicenseNumber] nvarchar(4000),\n\t[PassengerCount] nvarchar(4000),\n\t[TripDistance] nvarchar(4000),\n\t[RateCodeId] nvarchar(4000),\n\t[PaymentType] nvarchar(4000),\n\t[TotalAmount] nvarchar(4000),\n\t[FareAmount] nvarchar(4000),\n\t[Extra] nvarchar(4000),\n\t[MtaTax] nvarchar(4000),\n\t[TipAmount] nvarchar(4000),\n\t[TollsAmount] nvarchar(4000),\n\t[ImprovementSurcharge] nvarchar(4000)\n\t)\n\tWITH (\n\tLOCATION = 'output/data_161d0eb7-6638-4579-ac98-00b595bcc1c0_3b15003d-f890-4bb6-952e-85d58c3f57af.parquet',\n\tDATA_SOURCE = [taxidata_teststoragegithub_dfs_core_windows_net],\n\tFILE_FORMAT = [SynapseParquetFormat]\n\t)\nGO\n\n\nSELECT TOP 100 * FROM dbo.Taxi\nGO",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "database2",
						"poolName": "Built-in"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
